NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
CLOUD_SAVE_MAX_PAYLOAD_BYTES=10485760
CLOUD_SAVE_MAX_VERSIONS=5
CLOUD_SAVE_STORE=local
CLOUD_SAVE_DATA_DIR=.data/cloud-saves
DEVICE_LINK_CODE_TTL_MS=600000
RATE_LIMIT_MAX=300
RATE_LIMIT_TIME_WINDOW_MS=60000
RATE_LIMIT_REGISTRATION_MAX=5
RATE_LIMIT_REGISTRATION_TIME_WINDOW_MS=900000
RATE_LIMIT_SAVE_MAX=30
RATE_LIMIT_SAVE_TIME_WINDOW_MS=60000


# Optional front sharing. Keep disabled until the receiver and privacy policy are ready.
FRONT_SHARING_ENABLED=false
# All four APNS settings must be set together to enable alert delivery.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.allofme.companion
# APNS_KEY_PATH=/run/secrets/apns-key.p8
